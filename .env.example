# Copy to .env (Docker Compose reads it automatically).

# Required by the HTTP transport. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# Folder that contains oauth.keys.json and token.json.
# Linux/macOS: /home/you/.google   Windows: C:/Users/you/.google
GOOGLE_DIR=

# Tool surface: core (default), full, read-write, read-only.
MCP_TOOL_PROFILE=core

# Hide tools whose Google scope is missing at startup.
MCP_SCOPE_ROUTING=1

# Public links stay disabled unless this is explicitly enabled.
MCP_ALLOW_PUBLIC_SHARING=0

# Human approval queue for destructive actions.
# Host CLI: use ./data/approvals (the container sees /home/app/data/approvals).
MCP_APPROVAL_DIR=./data/approvals
MCP_APPROVAL_TTL=900
MCP_APPROVAL_URL=http://127.0.0.1:8765

# Staged Apps Script operations (prepared by one call, executed by another).
# Keep it on a persistent volume so a container recreate does not lose them.
MCP_OPERATION_DIR=./data/operations
MCP_OPERATION_TTL=600

# Folders drive_write(action="upload") may read from (comma-separated).
# Secrets (token, .env, keys, ~/.google, ~/.ssh) are always refused. In the
# container this is /home/app/data/upload (config.docker.yaml).
# MCP_UPLOAD_ROOTS=
