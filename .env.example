# Copy to .env (Docker Compose reads it automatically).

# Required by the HTTP transport. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# Folder that contains oauth.keys.json and token.json.
# Linux/macOS: /home/you/.google   Windows: C:/Users/you/.google
GOOGLE_DIR=

# Tool surface: core (default), full, read-write, read-only.
MCP_TOOL_PROFILE=core

# Hide tools whose Google scope is missing at startup.
MCP_SCOPE_ROUTING=1

# Public links stay disabled unless this is explicitly enabled.
MCP_ALLOW_PUBLIC_SHARING=0
