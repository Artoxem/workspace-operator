[
 {
  "name": "calendar_update_event",
  "description": "Update an existing event. Only the fields you pass are changed; send_updates controls attendee notifications.",
  "input_schema": {
   "type": "object",
   "properties": {
    "event_id": {
     "type": "string"
    },
    "calendar_id": {
     "type": "string",
     "default": "primary"
    },
    "summary": {
     "type": "string"
    },
    "start_time": {
     "type": "string",
     "description": "ISO datetime"
    },
    "end_time": {
     "type": "string",
     "description": "ISO datetime"
    },
    "description": {
     "type": "string"
    },
    "location": {
     "type": "string"
    },
    "attendees": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "send_updates": {
     "type": "string",
     "enum": [
      "all",
      "externalOnly",
      "none"
     ],
     "default": "none"
    }
   },
   "required": [
    "event_id"
   ]
  },
  "safety": "write"
 },
 {
  "name": "calendar_delete_event",
  "description": "Delete an event. Requires confirm=true.",
  "input_schema": {
   "type": "object",
   "properties": {
    "event_id": {
     "type": "string"
    },
    "calendar_id": {
     "type": "string",
     "default": "primary"
    },
    "confirm": {
     "type": "boolean",
     "default": false
    },
    "send_updates": {
     "type": "string",
     "enum": [
      "all",
      "externalOnly",
      "none"
     ],
     "default": "none"
    }
   },
   "required": [
    "event_id"
   ]
  },
  "safety": "destructive"
 },
 {
  "name": "calendar_respond_to_invite",
  "description": "Answer an invitation: accepted, declined or tentative. Requires confirm=true.",
  "input_schema": {
   "type": "object",
   "properties": {
    "event_id": {
     "type": "string"
    },
    "response": {
     "type": "string",
     "enum": [
      "accepted",
      "declined",
      "tentative"
     ]
    },
    "calendar_id": {
     "type": "string",
     "default": "primary"
    },
    "confirm": {
     "type": "boolean",
     "default": false
    },
    "send_updates": {
     "type": "string",
     "enum": [
      "all",
      "externalOnly",
      "none"
     ],
     "default": "all"
    }
   },
   "required": [
    "event_id",
    "response"
   ]
  },
  "safety": "write"
 },
